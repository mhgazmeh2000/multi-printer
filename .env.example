# =============================================================================
# .env.example : copy to .env and fill in the values. Never commit .env.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
# production | development. In production SECRET_KEY is required.
ENVIRONMENT=development
# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ─── CAPTCHA (login, register, contact form) ─────────────────────────────────
# The provider is chosen in the admin panel (⚙️ تنظیمات سیستم) and saved to system_config.json.
# This variable is only the default used before a choice is saved:
#   altcha    = self-hosted, no external request (default)
#   recaptcha = Google reCAPTCHA (the browser loads Google; the server calls Google)
#   none      = no CAPTCHA
CAPTCHA_PROVIDER=altcha

# Global emergency switch. false = CAPTCHA is OFF for every provider (Fail-Open).
# Use it when the CAPTCHA itself blocks the admin from logging in. Set it back to true afterwards.
CAPTCHA_ENABLED=true

# ALTCHA-only switch. false = the ALTCHA provider is off (reCAPTCHA is not affected).
ALTCHA_ENABLED=true

# Direct LAN bypass. Comma-separated CIDRs. A request that connects straight from one of these
# networks (no X-Forwarded-For / X-Real-IP) skips CAPTCHA. Empty = feature off (panel choice applies to all).
# Example: 172.16.25.0/24
CAPTCHA_BYPASS_NETWORKS=

# Reverse proxies whose traffic must follow the admin panel choice, even if the proxy sits in a bypass network.
# Comma-separated IPs/CIDRs. Example: 172.16.25.50
CAPTCHA_TRUSTED_PROXIES=

# ─── ALTCHA (self-hosted) ────────────────────────────────────────────────────
# Secret that signs CAPTCHA challenges. Required while ALTCHA is the active provider.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ALTCHA_HMAC_SECRET=

# PBKDF2 iterations the browser must compute per challenge (ALTCHA-recommended value).
# Higher = harder for bots, slower for users. Measured here: about 0.2 s mean per solve.
ALTCHA_COST=5000

# Challenge lifetime in seconds. A solved challenge can be used only once.
ALTCHA_CHALLENGE_TTL_SECONDS=300

# ─── reCAPTCHA (optional, Google) ────────────────────────────────────────────
# Only used when CAPTCHA_PROVIDER (or the admin panel) selects recaptcha.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
